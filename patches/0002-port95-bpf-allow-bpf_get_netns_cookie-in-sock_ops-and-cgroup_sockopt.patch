From: port95 backport <port95@localhost>
Subject: [PATCH] port95: bpf: allow bpf_get_netns_cookie in SOCK_OPS and CGROUP_SOCKOPT

Backport of upstream v5.15 commits fab60e29fcc6 ("bpf: Allow bpf_get_netns_cookie
in BPF_PROG_TYPE_SOCK_OPS") and 6cf1770d63dd ("bpf: Allow bpf_get_netns_cookie in
BPF_PROG_TYPE_CGROUP_SOCKOPT"), adapted to N0's atomic64 net->net_cookie.

Reason: with the vgate uname spoof (5.15.136) tethering netbpfload loads netd.o
and selects sockops/prog$5_15, getsockopt/prog$5_15_v and setsockopt/prog$5_15_v
(non-optional). All three call helper #122 at insn 1; N0's sock_ops_func_proto and
cg_sockopt_func_proto lack it, so BPF_PROG_LOAD fails ("unknown func
bpf_get_netns_cookie#122"), netbpfload logs CRITICAL FAILURE, sleeps 20 s and exits
38 -> init reboot_on_failure (boot attempt 2, 24.699 s).

NOT BUILT, NOT RUNTIME-TESTED (VPS unreachable, local compile disallowed).
---
--- a/net/core/filter.c
+++ b/net/core/filter.c
@@ -4751,6 +4751,17 @@
 	.arg1_type	= ARG_PTR_TO_CTX_OR_NULL,
 };
 
+BPF_CALL_1(bpf_get_netns_cookie_sock_ops, struct bpf_sock_ops_kern *, ctx)
+{
+	return __bpf_get_netns_cookie(ctx ? ctx->sk : NULL);
+}
+
+static const struct bpf_func_proto bpf_get_netns_cookie_sock_ops_proto = {
+	.func		= bpf_get_netns_cookie_sock_ops,
+	.ret_type	= RET_INTEGER,
+	.arg1_type	= ARG_PTR_TO_CTX_OR_NULL,
+};
+
 BPF_CALL_1(bpf_get_socket_uid, struct sk_buff *, skb)
 {
 	struct sock *sk = sk_to_full_sk(skb->sk);
@@ -7543,6 +7554,8 @@
 		return &bpf_sock_hash_update_proto;
 	case BPF_FUNC_get_socket_cookie:
 		return &bpf_get_socket_cookie_sock_ops_proto;
+	case BPF_FUNC_get_netns_cookie:
+		return &bpf_get_netns_cookie_sock_ops_proto;
 	case BPF_FUNC_get_local_storage:
 		return &bpf_get_local_storage_proto;
 	case BPF_FUNC_perf_event_output:
--- a/kernel/bpf/cgroup.c
+++ b/kernel/bpf/cgroup.c
@@ -1901,11 +1901,29 @@
 const struct bpf_prog_ops cg_sysctl_prog_ops = {
 };
 
+#ifdef CONFIG_NET
+BPF_CALL_1(bpf_get_netns_cookie_sockopt, struct bpf_sockopt_kern *, ctx)
+{
+	const struct net *net = ctx ? sock_net(ctx->sk) : &init_net;
+
+	return atomic64_read(&net->net_cookie);
+}
+
+static const struct bpf_func_proto bpf_get_netns_cookie_sockopt_proto = {
+	.func		= bpf_get_netns_cookie_sockopt,
+	.gpl_only	= false,
+	.ret_type	= RET_INTEGER,
+	.arg1_type	= ARG_PTR_TO_CTX_OR_NULL,
+};
+#endif
+
 static const struct bpf_func_proto *
 cg_sockopt_func_proto(enum bpf_func_id func_id, const struct bpf_prog *prog)
 {
 	switch (func_id) {
 #ifdef CONFIG_NET
+	case BPF_FUNC_get_netns_cookie:
+		return &bpf_get_netns_cookie_sockopt_proto;
 	case BPF_FUNC_sk_storage_get:
 		return &bpf_sk_storage_get_proto;
 	case BPF_FUNC_sk_storage_delete:
